---
import { siteConfig, socialLinks } from '../data/site';

const year = new Date().getFullYear();
---

<footer class="site-footer">
	<div class="site-footer__inner">
		<div>
			<p class="eyebrow">End Note</p>
			<p class="footer-copy">
				{siteConfig.name} builds Astro-first interfaces with room for future islands.
			</p>
		</div>
		<div class="footer-links">
			{
				socialLinks.map((link) => (
					<a href={link.href} target={link.external ? '_blank' : undefined} rel={link.external ? 'noreferrer' : undefined}>
						{link.label}
					</a>
				))
			}
		</div>
		<p class="footer-copy">Copyright {year}</p>
	</div>
</footer>
