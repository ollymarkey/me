---
// Localiyo analytics. Without a consent banner it sends cookieless page views only.
// Only production deployments load it, so local, test, and preview builds stay out of the data.
const enabled = process.env.VERCEL_ENV === 'production';
---

{enabled && (
	<script
		is:inline
		defer
		src="https://api.localiyo.com/tracker/v1.js"
		data-site="9bf4d235-6e20-4d0a-a032-bdc5b2de4038"
	></script>
)}
