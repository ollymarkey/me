---
import { getCollection } from 'astro:content';
import BlogCard from '../components/BlogCard.astro';
import SectionHeading from '../components/SectionHeading.astro';
import { siteConfig, socialLinks } from '../data/site';
import { sortBlogEntries } from '../lib/blog';
import Layout from '../layouts/Layout.astro';

const featuredPosts = sortBlogEntries(await getCollection('blog', ({ data }) => !data.draft)).slice(0, 2);
---

<Layout description={siteConfig.description}>
	<section class="hero panel-grid">
		<div class="paper-panel hero-copy reveal">
			<h1>{siteConfig.hero.headline}</h1>
			<p class="lede">{siteConfig.hero.summary}</p>
			<div class="hero-actions">
				<a class="button button-primary" href={siteConfig.hero.primaryCta.href}>
					{siteConfig.hero.primaryCta.label}
				</a>
				<a class="button button-secondary" href={siteConfig.hero.secondaryCta.href}>
					{siteConfig.hero.secondaryCta.label}
				</a>
			</div>
		</div>
		<aside class="paper-panel hero-note reveal">
			<ul class="detail-list">
				<li>
					<strong>Focus</strong>
					<span>{siteConfig.hero.focus}</span>
				</li>
				<li>
					<strong>Based</strong>
					<span>{siteConfig.location}</span>
				</li>
				<li>
					<strong>Status</strong>
					<span>{siteConfig.availability}</span>
				</li>
			</ul>
			<ul class="check-list" style="margin-top: 1rem;">
				{siteConfig.principles.map((principle) => <li>{principle}</li>)}
			</ul>
		</aside>
	</section>

	<section id="blog-preview" class="section-stack">
		<SectionHeading
			eyebrow="Journal"
			title="Writing about the systems behind the product."
			intro="Notes on Astro workflows, AI-native tooling, fullstack architecture, and the small design decisions that make software feel finished."
		/>
		<div class="blog-grid">
			{
				featuredPosts.length > 0 ? (
					featuredPosts.map((post) => <BlogCard post={post} />)
				) : (
					<article class="paper-panel empty-state">
						<h3>The notebook is empty for now.</h3>
						<p>Blog posts can be added in <code>src/content/blog</code> and will appear here automatically.</p>
					</article>
				)
			}
		</div>
		<div class="section-cta">
			<a class="button button-secondary" href="/blog">Browse the full blog</a>
		</div>
	</section>

	<section id="contact" class="section-stack">
		<SectionHeading
			eyebrow="Contact"
			title="Open to thoughtful product, platform, and AI-enabled build work."
			intro="If you need stronger fullstack execution, sharper AI workflows, or a cleaner path from idea to shipped product, send a note."
		/>
		<div class="contact-grid">
			<div class="paper-panel reveal">
				<p class="contact-callout">{siteConfig.contactMessage}</p>
				<a class="button button-primary" href={`mailto:${siteConfig.email}`}>
					Email {siteConfig.email}
				</a>
			</div>
			<div class="paper-panel reveal">
				<p class="eyebrow">Links</p>
				<ul class="contact-list">
					{
						socialLinks.map((link) => (
							<li>
								<a href={link.href} target={link.external ? '_blank' : undefined} rel={link.external ? 'noreferrer' : undefined}>
									<span>{link.label}</span>
									<span>{link.note}</span>
								</a>
							</li>
						))
					}
				</ul>
			</div>
		</div>
	</section>
</Layout>
