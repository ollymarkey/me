---
import Workspace from '../components/workspace/Workspace';
import { channels } from '../lib/chat/answers.server';
import { siteConfig } from '../data/site';
import '../styles/workspace.css';
import geistRegular from '@fontsource/geist/files/geist-latin-400-normal.woff2?url';

const description = 'Olly Markey’s personal workspace. Explore my background, fullstack skills, AI workflows, and writing through a guided conversation.';
const site = siteConfig.siteUrl ?? Astro.site?.toString();
---

<!doctype html>
<html lang="en">
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<meta name="theme-color" content="#f5f5f5" />
		<link rel="preload" href={geistRegular} as="font" type="font/woff2" crossorigin="anonymous" />
		<title>Olly Markey | Personal workspace</title>
		<meta name="description" content={description} />
		<meta property="og:title" content="Olly Markey | Personal workspace" />
		<meta property="og:description" content={description} />
		<meta property="og:type" content="website" />
		<meta property="og:site_name" content={siteConfig.name} />
		<meta name="twitter:card" content="summary_large_image" />
		<meta name="twitter:title" content="Olly Markey | Personal workspace" />
		<meta name="twitter:description" content={description} />
		{site && <><link rel="canonical" href={new URL('/', site).toString()} /><meta property="og:url" content={new URL('/', site).toString()} /><meta property="og:image" content={new URL('/og-cover.svg', site).toString()} /><meta name="twitter:image" content={new URL('/og-cover.svg', site).toString()} /></>}
		<link rel="icon" href="/favicon.ico" sizes="any" />
		<link rel="apple-touch-icon" href="/apple-touch-icon.png" />
		<link rel="manifest" href="/site.webmanifest" />
		<script is:inline>
			try {
				const saved = localStorage.getItem('olly-theme');
				document.documentElement.dataset.theme = saved || (matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light');
			} catch { document.documentElement.dataset.theme = matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light'; }
		</script>
		<script>
			// Keep browser chrome aligned with the palette, including manual overrides.
			const root = document.documentElement;
			function syncThemeColor() {
				const color = getComputedStyle(root).getPropertyValue('--ws-sidebar').trim();
				document.querySelector('meta[name="theme-color"]')?.setAttribute('content', color);
			}
			syncThemeColor();
			new MutationObserver(syncThemeColor).observe(root, {
				attributes: true,
				attributeFilter: ['data-theme'],
			});
		</script>
	</head>
	<body>
		<a class="skip-link" href="#main-content">Skip to conversation</a>
		<noscript><div class="no-js">I’m Olly Markey, a fullstack developer based in Melbourne, building enterprise SaaS for Lexin Solutions. Enable JavaScript to explore the guided workspace, <a href="/blog">read my blog</a>, or <a href={`mailto:${siteConfig.email}`}>get in touch by email</a>.</div></noscript>
		<Workspace channels={channels} client:load />
	</body>
</html>
