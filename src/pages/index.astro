---
import { getCollection } from 'astro:content';
import BlogCard from '../components/BlogCard.astro';
import ProjectCard from '../components/ProjectCard.astro';
import SectionHeading from '../components/SectionHeading.astro';
import { featuredProjects, siteConfig, skillGroups, socialLinks } from '../data/site';
import { sortBlogEntries } from '../lib/blog';
import Layout from '../layouts/Layout.astro';

const featuredPosts = sortBlogEntries(await getCollection('blog', ({ data }) => !data.draft)).slice(0, 2);
---

<Layout title="Portfolio" description={siteConfig.description}>
	<section class="hero panel-grid">
		<div class="paper-panel hero-copy reveal">
			<p class="eyebrow">{siteConfig.hero.eyebrow}</p>
			<h1>{siteConfig.hero.headline}</h1>
			<p class="lede">{siteConfig.hero.summary}</p>
			<div class="hero-actions">
				<a class="button button-primary" href={siteConfig.hero.primaryCta.href}>
					{siteConfig.hero.primaryCta.label}
				</a>
				<a class="button button-secondary" href={siteConfig.hero.secondaryCta.href}>
					{siteConfig.hero.secondaryCta.label}
				</a>
			</div>
		</div>
		<aside class="paper-panel hero-note reveal">
			<p class="eyebrow">Field Notes</p>
			<ul class="detail-list">
				<li>
					<strong>Focus</strong>
					<span>{siteConfig.hero.focus}</span>
				</li>
				<li>
					<strong>Based</strong>
					<span>{siteConfig.location}</span>
				</li>
				<li>
					<strong>Status</strong>
					<span>{siteConfig.availability}</span>
				</li>
			</ul>
		</aside>
	</section>

	<section id="projects" class="section-stack">
		<SectionHeading
			eyebrow="Selected Work"
			title="Case studies shaped by structure, clarity, and shipping discipline."
			intro="Each project is framed as a product system: what needed to change, how the interface evolved, and what the team could do faster afterward."
		/>
		<div class="project-grid">
			{featuredProjects.map((project, index) => <ProjectCard project={project} featured={index === 0} />)}
		</div>
	</section>

	<section id="about" class="section-stack">
		<SectionHeading
			eyebrow="About"
			title="I like interfaces that feel intentional on first load and maintainable six months later."
			intro="The site is Astro-first by design: clean content boundaries now, room for islands and mixed-framework experiments when interaction is worth the cost."
		/>
		<div class="about-grid">
			<div class="paper-panel reveal">
				{siteConfig.about.map((paragraph) => <p>{paragraph}</p>)}
			</div>
			<div class="paper-panel reveal">
				<p class="eyebrow">Working Preferences</p>
				<ul class="check-list">
					{siteConfig.principles.map((principle) => <li>{principle}</li>)}
				</ul>
			</div>
		</div>
	</section>

	<section id="skills" class="section-stack">
		<SectionHeading
			eyebrow="Capabilities"
			title="A practical toolkit for content-heavy, interface-rich web work."
			intro="Grouped by the kind of decisions they help support rather than by logo count."
		/>
		<div class="skills-grid">
			{
				skillGroups.map((group) => (
					<article class="paper-panel reveal">
						<p class="eyebrow">{group.title}</p>
						<ul class="tag-list" aria-label={group.title}>
							{group.items.map((item) => <li>{item}</li>)}
						</ul>
					</article>
				))
			}
		</div>
	</section>

	<section id="blog-preview" class="section-stack">
		<SectionHeading
			eyebrow="Journal"
			title="Writing about the systems behind the interface."
			intro="Notes on Astro workflows, content architecture, and the small design decisions that make a site feel finished."
		/>
		<div class="blog-grid">
			{
				featuredPosts.length > 0 ? (
					featuredPosts.map((post) => <BlogCard post={post} />)
				) : (
					<article class="paper-panel empty-state">
						<h3>The notebook is empty for now.</h3>
						<p>Blog posts can be added in <code>src/content/blog</code> and will appear here automatically.</p>
					</article>
				)
			}
		</div>
		<div class="section-cta">
			<a class="button button-secondary" href="/blog">Browse the full blog</a>
		</div>
	</section>

	<section id="contact" class="section-stack">
		<SectionHeading
			eyebrow="Contact"
			title="Open to thoughtful product, design-system, and content-platform work."
			intro="If you have a project that needs a clearer front end, a sharper content structure, or a cleaner handoff between design and engineering, send a note."
		/>
		<div class="contact-grid">
			<div class="paper-panel reveal">
				<p class="contact-callout">{siteConfig.contactMessage}</p>
				<a class="button button-primary" href={`mailto:${siteConfig.email}`}>
					Email {siteConfig.email}
				</a>
			</div>
			<div class="paper-panel reveal">
				<p class="eyebrow">Links</p>
				<ul class="contact-list">
					{
						socialLinks.map((link) => (
							<li>
								<a href={link.href} target={link.external ? '_blank' : undefined} rel={link.external ? 'noreferrer' : undefined}>
									<span>{link.label}</span>
									<span>{link.note}</span>
								</a>
							</li>
						))
					}
				</ul>
			</div>
		</div>
	</section>
</Layout>
